---
import { safeNext } from "../server/auth.ts";

export const prerender = false;

const next = safeNext(Astro.url.searchParams.get("next"));
const error = Astro.url.searchParams.get("error");
const signedOut = Astro.url.searchParams.has("signedOut");

const messages: Record<string, string> = {
  wrong: "That password isn't right.",
  locked: "Too many attempts. Try again in 15 minutes.",
  unset: "No password is set for this site yet. Add a CMS_PASSWORD secret to the Worker.",
};
const message = error ? (messages[error] ?? "Sign-in failed.") : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in · Astro CMS</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #0f1013;
        --panel: #14161a;
        --line: #2a2d34;
        --line-strong: #373b44;
        --text: #e6e7ea;
        --text-2: #a7abb4;
        --text-3: #767b86;
        --accent: #3b82f6;
        --danger: #fca5a5;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; }
      body {
        display: grid;
        place-items: center;
        padding: 16px;
        background: var(--bg);
        color: var(--text);
        font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Inter, Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      main {
        width: min(360px, 100%);
        padding: 32px 28px 28px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--panel);
      }
      .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; font-weight: 600; }
      .mark {
        display: grid; place-items: center; width: 28px; height: 28px; border-radius: 6px;
        background: #c2f52f; color: #111; font-weight: 800;
      }
      h1 { margin: 0 0 4px; font-size: 20px; }
      p { margin: 0 0 20px; color: var(--text-2); }
      label { display: block; margin-bottom: 6px; font-weight: 600; }
      input {
        display: block; width: 100%; height: 40px; padding: 0 12px;
        border: 1px solid var(--line-strong); border-radius: 7px;
        background: var(--bg); color: var(--text); font: inherit; outline: none;
      }
      input:focus { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
      button {
        width: 100%; height: 40px; margin-top: 16px;
        border: 0; border-radius: 7px; background: var(--accent); color: #fff;
        font: inherit; font-weight: 600; cursor: pointer;
      }
      button:hover { background: #2f6fdc; }
      button:disabled { opacity: 0.6; cursor: progress; }
      .notice { margin: 0 0 16px; padding: 10px 12px; border-radius: 7px; font-size: 13px; }
      .notice.error { background: #2a1215; border: 1px solid #7f1d1d; color: var(--danger); }
      .notice.info { background: #13233f; border: 1px solid #1d3a6b; color: #bcd4ff; }
      footer { margin-top: 20px; color: var(--text-3); font-size: 12px; text-align: center; }
      footer a { color: inherit; }
    </style>
  </head>
  <body>
    <main>
      <div class="brand"><span class="mark">A</span> Astro CMS</div>
      <h1>Sign in</h1>
      <p>Enter the editor password to edit this site.</p>
      {message && <div class="notice error" role="alert">{message}</div>}
      {signedOut && !message && <div class="notice info" role="status">You're signed out.</div>}
      <form method="post" action="/api/cms/auth/login">
        <input type="hidden" name="next" value={next} />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
        <button type="submit">Sign in</button>
      </form>
      <footer><a href="/">Back to the site</a></footer>
    </main>
    <script>
      document.querySelector("form")?.addEventListener("submit", (e) => {
        const button = (e.currentTarget as HTMLFormElement).querySelector("button");
        if (button) {
          button.disabled = true;
          button.textContent = "Signing in…";
        }
      });
    </script>
  </body>
</html>
