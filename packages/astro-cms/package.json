{
  "name": "@johannes-fraundorfer/astro-cms",
  "version": "0.5.3",
  "description": "Git-backed content editing for Astro sites: a dashboard with a live canvas, drafts, translations and a media library.",
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "visual-editor",
    "cloudflare",
    "git-based-cms"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Johannes-Fraundorfer/astro-cms#readme",
  "bugs": {
    "url": "https://github.com/Johannes-Fraundorfer/astro-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johannes-Fraundorfer/astro-cms.git",
    "directory": "packages/astro-cms"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "astro-cms": "bin/astro-cms.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./collections": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./env": "./dist/env.d.ts"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "ultrahtml": "^1.6.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  }
}
