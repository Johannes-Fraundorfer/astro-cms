{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astro-cms-playground",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/cms/*", "/_cms/*", "/_image"],
  },
  // Local only: `astro dev` keeps this database in .wrangler/.
  "d1_databases": [
    { "binding": "CMS_DB", "database_name": "playground-cms", "database_id": "00000000-0000-0000-0000-000000000000" },
  ],
  // Optional: turns on video uploads. Locally the bucket lives in .wrangler/ too.
  "r2_buckets": [{ "binding": "CMS_MEDIA", "bucket_name": "playground-media" }],
}
