---
import Base from "../../layouts/Base.astro";
import { cmsAttrs, cmsList } from "@johannes-fraundorfer/astro-cms/runtime";

type Article = { title?: string; slug?: string; excerpt?: string };
const articles = await cmsList<Article>(Astro, "articles");
const cms = cmsAttrs(Astro);
---

<Base title="Articles">
  <h1>Articles</h1>
  <ul class="list">
    {
      articles.map((a) => (
        <li {...cms.doc(a)}>
          <a href={`/articles/${a.data.slug}`} {...cms.field("title", "text", "Title")}>{a.data.title}</a>
          <p class="muted" {...cms.field("excerpt", "multiline", "Excerpt")}>{a.data.excerpt}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .list { list-style: none; padding: 0; display: grid; gap: 24px; }
  .list a { font-size: 1.25rem; font-weight: 600; color: inherit; }
</style>
