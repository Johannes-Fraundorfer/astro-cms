---
import { cmsEntry } from "@johannes-fraundorfer/astro-cms/runtime";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const settings = await cmsEntry<{ siteName?: string; description?: string }>(Astro, "settings", "settings");
const siteName = settings?.data.siteName ?? "Site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    <meta name="description" content={description || settings?.data.description || ""} />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">{siteName}</a>
      <nav><a href="/">Home</a><a href="/articles">Articles</a></nav>
    </header>
    <main><slot /></main>
    <footer class="bar"><small>© {new Date().getFullYear()} {siteName}</small></footer>
  </body>
</html>

<style is:global>
  :root { --text: #18181b; --muted: #71717a; --line: #e4e4e7; --accent: #4f46e5; font-family: system-ui, sans-serif; color: var(--text); }
  body { margin: 0; line-height: 1.55; }
  main { max-width: 960px; margin: 0 auto; padding: 0 24px 64px; }
  .bar { display: flex; justify-content: space-between; align-items: center; max-width: 960px; margin: 0 auto; padding: 20px 24px; }
  .bar nav { display: flex; gap: 20px; }
  .bar a { color: inherit; text-decoration: none; }
  .brand { font-weight: 700; }
  footer.bar { color: var(--muted); border-top: 1px solid var(--line); }
  .button { display: inline-block; padding: 10px 18px; border-radius: 8px; background: var(--accent); color: #fff; text-decoration: none; }
  .muted { color: var(--muted); }
  img { max-width: 100%; height: auto; border-radius: 12px; }
</style>
